# Copy to .env to override the local defaults used by docker compose.
POSTGRES_PASSWORD=change-me
# At least 32 characters. Signs the access tokens.
JWT_SIGNING_KEY=replace-this-with-a-long-random-value-of-at-least-32-characters
# Shared by the API and the test payment provider.
PAYMENTS_API_KEY=replace-with-a-random-value
PAYMENTS_WEBHOOK_SECRET=replace-with-another-random-value
