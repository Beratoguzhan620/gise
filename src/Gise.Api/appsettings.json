{
  "ConnectionStrings": {
    "Gise": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "gise",
    "Audience": "gise-clients",
    "AccessTokenMinutes": 120
  },
  "Auth": {
    "AttemptsPerMinute": 10
  },
  "Payments": {
    "Provider": "Sandbox",
    "BaseUrl": "http://localhost:5601/",
    "ReturnUrl": "http://localhost:5173/orders/{orderId}",
    "PaymentMinutes": 10,
    "TimeoutSeconds": 15
  },
  "Sales": {
    "HoldMinutes": 8,
    "ShoppingMinutes": 15,
    "HoldsPerMinute": 30,
    "ReconcileSeconds": 15,
    "PaymentGraceSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
